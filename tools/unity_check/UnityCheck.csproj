<!--
  Compile le code Unity (Assets/Scripts et les tests PlayMode) hors Unity, pour les sessions cloud :
  références UnityEngine 2021.3 (paquet NuGet unityengine.modules, téléchargé dans build/unityref par
  tools/check_unity_compile.sh) et petits stubs pour uGUI et le Test Framework (UiStub.cs, TestStub.cs).
  Ne remplace pas la compilation dans Unity 6 (API absentes de 2021.3 ignorées par le script).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0067;CS0168;CS0219;CS0414;CS0649;CS1591</NoWarn>
    <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
    <UnityRef>$(RepoRoot)build/unityref/lib/netstandard2.0/</UnityRef>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets/Scripts/**/*.cs" />
    <Compile Include="$(RepoRoot)Assets/Tests/PlayMode/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UnityRef)*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>
</Project>
